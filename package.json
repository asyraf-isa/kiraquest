{
  "name": "kiraquest",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "lucide-react": "^1.77.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@prisma/client": "~7.10.1",
      "@trpc/server": "^11.29.5",
      "@trpc/client": "^11.29.5",
      "better-auth": "1.7.27",
      "autumn-js": "~1.5.86",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @kiraquest/db --",
    "db:studio": "turbo run db:studio -F @kiraquest/db --",
    "db:generate": "turbo run db:generate -F @kiraquest/db --",
    "db:migrate": "turbo run db:migrate -F @kiraquest/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kiraquest/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@2.0.1"
  },
  "packageManager": "bun@1.4.5"
}
